{
  "name": "stamp-backend",
  "version": "1.0.0",
  "description": "STAMP Backend API Services",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:reset": "tsx src/scripts/reset.ts",
    "crypto:test": "tsx src/scripts/test-crypto.ts",
    "security:audit": "npm audit && snyk test"
  },
  "dependencies": {
    "@fastify/autoload": "^5.7.1",
    "@fastify/cors": "^8.5.0",
    "@fastify/env": "^4.2.0",
    "@fastify/jwt": "^7.2.4",
    "@fastify/swagger": "^8.8.0",
    "@fastify/swagger-ui": "^1.9.3",
    "bcrypt": "^5.1.0",
    "crypto-js": "^4.1.1",
    "date-fns": "^2.30.0",
    "express-rate-limit": "^6.8.1",
    "fastify": "^4.21.0",
    "fastify-cors": "^6.1.0",
    "fastify-helmet": "^7.0.0",
    "fastify-jwt": "^4.0.0",
    "fastify-rate-limit": "^5.9.0",
    "fastify-websocket": "^4.3.0",
    "geohash": "^0.0.1",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.1",
    "libsodium-wrappers": "^0.7.11",
    "node-forge": "^1.3.1",
    "pg": "^8.11.1",
    "pkcs11js": "^2.0.0",
    "qrcode": "^1.5.3",
    "redis": "^4.6.7",
    "uuid": "^9.0.0",
    "winston": "^3.10.0",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/crypto-js": "^4.1.1",
    "@types/jest": "^29.5.3",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.4.2",
    "@types/pg": "^8.10.2",
    "@types/qrcode": "^1.5.1",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^9.0.2",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "jest": "^29.6.1",
    "prettier": "^3.0.0",
    "snyk": "^1.1193.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "tsc-alias": "^1.8.7",
    "tsx": "^3.12.7",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
