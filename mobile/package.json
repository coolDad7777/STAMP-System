{
  "name": "stamp-mobile",
  "version": "1.0.0",
  "description": "STAMP Mobile Application for iOS and Android",
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "ios": "react-native run-ios",
    "android": "react-native run-android",
    "build:ios": "react-native build-ios --mode=Release",
    "build:android": "cd android && ./gradlew assembleRelease",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "clean": "react-native clean",
    "clean:ios": "cd ios && xcodebuild clean",
    "clean:android": "cd android && ./gradlew clean",
    "pods": "cd ios && pod install",
    "security:audit": "npm audit"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.72.4",
    "@react-navigation/native": "^6.1.7",
    "@react-navigation/bottom-tabs": "^6.5.8",
    "@react-navigation/stack": "^6.3.17",
    "react-native-screens": "^3.22.1",
    "react-native-safe-area-context": "^4.7.1",
    "react-native-gesture-handler": "^2.12.1",
    "react-native-reanimated": "^3.4.0",
    "mobx": "^6.9.0",
    "mobx-react-lite": "^4.0.3",
    "mobx-persist-store": "^1.1.4",
    "react-native-mmkv": "^2.10.1",
    "react-native-keychain": "^8.1.3",
    "react-native-biometrics": "^3.0.1",
    "react-native-device-info": "^10.8.0",
    "react-native-geolocation-service": "^5.3.1",
    "@react-native-community/netinfo": "^9.3.10",
    "react-native-vision-camera": "^3.2.0",
    "vision-camera-code-scanner": "^0.2.0",
    "react-native-qrcode-svg": "^6.1.0",
    "react-native-svg": "^14.1.0",
    "react-native-vector-icons": "^10.0.0",
    "react-native-elements": "^3.4.3",
    "react-native-paper": "^5.9.1",
    "react-native-toast-message": "^2.1.6",
    "react-native-modal": "^13.0.1",
    "react-native-progress": "^5.0.1",
    "react-native-animatable": "^1.3.3",
    "crypto-js": "^4.1.1",
    "libsodium": "^0.7.11",
    "geohash": "^0.0.1",
    "date-fns": "^2.30.0",
    "uuid": "^9.0.0",
    "axios": "^1.4.0",
    "react-hook-form": "^7.45.2",
    "zod": "^3.21.4",
    "@hookform/resolvers": "^3.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.22.9",
    "@babel/preset-env": "^7.22.9",
    "@babel/runtime": "^7.22.6",
    "@react-native/eslint-config": "^0.72.2",
    "@react-native/metro-config": "^0.72.9",
    "@react-native/typescript-config": "^0.73.1",
    "@types/react": "^18.2.14",
    "@types/react-native": "^0.72.2",
    "@types/react-test-renderer": "^18.0.0",
    "@types/crypto-js": "^4.1.1",
    "@types/uuid": "^9.0.2",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "babel-jest": "^29.6.1",
    "detox": "^20.10.0",
    "eslint": "^8.45.0",
    "jest": "^29.6.1",
    "metro-react-native-babel-preset": "^0.76.7",
    "prettier": "^3.0.0",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.1.6",
    "@storybook/react-native": "^6.5.6"
  },
  "jest": {
    "preset": "react-native",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/tests/setup.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/tests/**"
    ]
  },
  "detox": {
    "test-runner": "jest",
    "runner-config": "e2e/config.json",
    "configurations": {
      "ios.sim.debug": {
        "device": "simulator",
        "app": "ios.debug"
      },
      "android.emu.debug": {
        "device": "emulator",
        "app": "android.debug"
      }
    },
    "devices": {
      "simulator": {
        "type": "ios.simulator",
        "device": {
          "type": "iPhone 14"
        }
      },
      "emulator": {
        "type": "android.emulator",
        "device": {
          "avdName": "Pixel_API_33"
        }
      }
    },
    "apps": {
      "ios.debug": {
        "type": "ios.app",
        "binaryPath": "ios/build/Build/Products/Debug-iphonesimulator/StampMobile.app"
      },
      "android.debug": {
        "type": "android.apk",
        "binaryPath": "android/app/build/outputs/apk/debug/app-debug.apk"
      }
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
